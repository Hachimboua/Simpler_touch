* {
    background: #121212;
    color: #e0e0e0;
    border: none;
    font-family: "Segoe UI", "Inter", "JetBrains Mono", "Courier New", monospace;
    font-size: 12px;
}

QMainWindow, QWidget {
    background: #121212;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* Scrollbar Styling */
QScrollBar:vertical {
    border: none;
    background: #1a1a1a;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #333333;
    min-height: 20px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #444444;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    border: none;
}

QDockWidget::title {
    background: #1a1a1a;
    color: #ffffff;
    border-bottom: 1px solid #2a2a2a;
    padding: 8px 12px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QGroupBox {
    background: #1e1e1e;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 10px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    color: #00e5ff;
    background: #121212;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    left: 10px;
}

QLabel {
    background: transparent;
    border: none;
    color: #aaaaaa;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QListWidget {
    background: #252525;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 4px 8px;
    color: #ffffff;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #00e5ff;
    background: #2a2a2a;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #888888;
    margin-right: 8px;
}

QPushButton {
    background: #333333;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 6px 12px;
    color: #ffffff;
    font-weight: 600;
}

QPushButton:hover {
    background: #444444;
    border: 1px solid #555555;
}

QPushButton:pressed {
    background: #222222;
}

QPushButton:disabled {
    background: #1a1a1a;
    color: #555555;
    border: 1px solid #222222;
}

/* Primary Action Button */
QPushButton#primary_btn {
    background: #00838f;
    border: 1px solid #0097a7;
}

QPushButton#primary_btn:hover {
    background: #0097a7;
}

QCheckBox {
    spacing: 8px;
    color: #e0e0e0;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #444444;
    border-radius: 3px;
    background: #252525;
}

QCheckBox::indicator:hover {
    border: 1px solid #00e5ff;
}

QCheckBox::indicator:checked {
    background: #00e5ff;
    image: none; /* Can add a checkmark icon if needed */
}

QCheckBox::indicator:checked::after {
    /* CSS hack for checkmark if supported by Qt version, otherwise use image */
}

QStatusBar {
    background: #1a1a1a;
    border-top: 1px solid #2a2a2a;
    color: #888888;
}

QStatusBar QLabel {
    padding: 0 10px;
    border-left: 1px solid #2a2a2a;
}

QMenuBar {
    background: #1a1a1a;
    border-bottom: 1px solid #2a2a2a;
}

QMenuBar::item {
    padding: 6px 10px;
}

QMenuBar::item:selected {
    background: #2a2a2a;
}

QMenu {
    background: #1e1e1e;
    border: 1px solid #333333;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 2px;
}

QMenu::item:selected {
    background: #00e5ff;
    color: #0e0e0e;
}

#playback_bar {
    background: #181818;
    border-top: 1px solid #2a2a2a;
    padding: 8px 12px;
}

#playback_bar QPushButton {
    background: transparent;
    border: none;
    color: #bbbbbb;
    font-size: 16px;
    min-width: 32px;
    min-height: 32px;
    border-radius: 16px;
}

#playback_bar QPushButton:hover {
    background: #333333;
    color: #ffffff;
}

#playback_bar QPushButton:checked {
    background: #004d40;
    color: #4caf80;
}

#timeline_slider::groove:horizontal {
    height: 4px;
    background: #333333;
    border-radius: 2px;
}

#timeline_slider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background: #00e5ff;
    border: 2px solid #121212;
}

#timeline_slider::handle:horizontal:hover {
    background: #ffffff;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

#timeline_slider::sub-page:horizontal {
    background: #00e5ff;
    border-radius: 2px;
}

#timecode_label {
    color: #00e5ff;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: bold;
}

QProgressBar {
    background: #252525;
    border: 1px solid #333333;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
    height: 12px;
}

QProgressBar::chunk {
    background: #00e5ff;
    border-radius: 3px;
}
