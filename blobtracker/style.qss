/* ===========================================================================
   BlobTracker — Professional Dark Theme
   =========================================================================== */

* {
    background: #0c0e10;
    color: #cdd2da;
    font-family: "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    outline: none;
}

/* ── Window & Root ─────────────────────────────────────────────────────────── */

QMainWindow {
    background: #0c0e10;
}

QWidget {
    background: transparent;
}

/* ── Dock Widget ───────────────────────────────────────────────────────────── */

QDockWidget {
    background: #101316;
    border: none;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background: #0a0c0e;
    color: #00c8f0;
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 2px;
    padding: 7px 12px;
    border-bottom: 1px solid #00c8f040;
    text-transform: uppercase;
}

/* ── Group Boxes (collapsible sections) ────────────────────────────────────── */

QGroupBox {
    background: #101316;
    border: 1px solid #1e2329;
    border-radius: 5px;
    margin-top: 18px;
    padding: 10px 8px 8px 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: -1px;
    background: #0c0e10;
    color: #5a8aaa;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 0 6px;
}

QGroupBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #2a3344;
    border-radius: 2px;
    background: #0c0e10;
}

QGroupBox::indicator:checked {
    background: #00c8f0;
    border-color: #00c8f0;
    image: none;
}

QGroupBox::indicator:unchecked {
    background: #101316;
    border-color: #2a3344;
}

/* ── Labels ────────────────────────────────────────────────────────────────── */

QLabel {
    background: transparent;
    color: #7a8a9a;
    font-size: 11px;
    border: none;
    padding: 1px 0;
}

/* ── Line Edits ────────────────────────────────────────────────────────────── */

QLineEdit {
    background: #090b0d;
    border: 1px solid #1e2530;
    border-radius: 3px;
    color: #b8c2cc;
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 11px;
    padding: 4px 8px;
    selection-background-color: #00c8f0;
    selection-color: #0c0e10;
}

QLineEdit:hover {
    border-color: #2e3d52;
}

QLineEdit:focus {
    border-color: #00c8f0;
    background: #0d1015;
}

/* ── Spin Boxes ────────────────────────────────────────────────────────────── */

QSpinBox, QDoubleSpinBox {
    background: #090b0d;
    border: 1px solid #1e2530;
    border-radius: 3px;
    color: #b8c2cc;
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 11px;
    padding: 3px 4px 3px 6px;
    min-width: 58px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #2e3d52;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #00c8f0;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: #161c24;
    border: none;
    border-left: 1px solid #1e2530;
    width: 16px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    border-top-right-radius: 3px;
    border-bottom: 1px solid #1e2530;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    border-bottom-right-radius: 3px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #1e2a38;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #5a7a96;
    margin: 0;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #5a7a96;
    margin: 0;
}

/* ── Combo Boxes ───────────────────────────────────────────────────────────── */

QComboBox {
    background: #090b0d;
    border: 1px solid #1e2530;
    border-radius: 3px;
    color: #b8c2cc;
    font-size: 11px;
    padding: 4px 28px 4px 8px;
    min-height: 22px;
}

QComboBox:hover {
    border-color: #2e3d52;
}

QComboBox:focus {
    border-color: #00c8f0;
}

QComboBox::drop-down {
    border: none;
    border-left: 1px solid #1e2530;
    background: #161c24;
    width: 22px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #5a7a96;
}

QComboBox QAbstractItemView {
    background: #13181f;
    border: 1px solid #2e3d52;
    border-radius: 4px;
    color: #b8c2cc;
    selection-background-color: #0d2a3f;
    selection-color: #00c8f0;
    padding: 3px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 5px 10px;
    min-height: 22px;
    border-radius: 2px;
}

QComboBox QAbstractItemView::item:hover {
    background: #1a2535;
}

/* ── Buttons ───────────────────────────────────────────────────────────────── */

QPushButton {
    background: #13181f;
    border: 1px solid #252d3a;
    border-radius: 3px;
    color: #9aaabb;
    font-size: 11px;
    padding: 5px 12px;
    min-height: 22px;
}

QPushButton:hover {
    background: #1a2230;
    border-color: #354560;
    color: #c8d2dc;
}

QPushButton:pressed {
    background: #0e1520;
    border-color: #00c8f0;
    color: #00c8f0;
}

QPushButton:focus {
    border-color: #00c8f060;
}

QPushButton:disabled {
    background: #0e1013;
    border-color: #161c22;
    color: #323c48;
}

QPushButton:checked {
    background: #0a2a1f;
    border-color: #00e676;
    color: #00e676;
}

/* ── Checkboxes ────────────────────────────────────────────────────────────── */

QCheckBox {
    background: transparent;
    color: #8a9aaa;
    spacing: 8px;
    font-size: 11px;
}

QCheckBox:hover {
    color: #b8c2cc;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #2a3a4e;
    border-radius: 2px;
    background: #090b0d;
}

QCheckBox::indicator:hover {
    border-color: #3e5a76;
}

QCheckBox::indicator:checked {
    background: #00c8f0;
    border-color: #00c8f0;
}

QCheckBox::indicator:checked:hover {
    background: #33d8ff;
}

/* ── Sliders ───────────────────────────────────────────────────────────────── */

QSlider::groove:horizontal {
    background: #161c24;
    border: 1px solid #252d3a;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #2a4060;
    border: 1px solid #3a5a80;
    width: 13px;
    height: 13px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #00c8f0;
    border-color: #00c8f0;
}

QSlider::sub-page:horizontal {
    background: #004d6a;
    border-radius: 2px;
    border: none;
}

QSlider::add-page:horizontal {
    background: transparent;
}

/* ── List Widget ───────────────────────────────────────────────────────────── */

QListWidget {
    background: #090b0d;
    border: 1px solid #1e2530;
    border-radius: 3px;
    color: #b8c2cc;
    font-size: 11px;
    outline: none;
    padding: 2px;
}

QListWidget::item {
    padding: 4px 8px;
    border-radius: 2px;
    min-height: 20px;
}

QListWidget::item:selected {
    background: #0d2a3f;
    color: #00c8f0;
}

QListWidget::item:hover {
    background: #141c28;
}

/* ── Scroll Area ───────────────────────────────────────────────────────────── */

QScrollArea {
    background: transparent;
    border: none;
}

/* ── Scrollbars ────────────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background: transparent;
    border: none;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #252d3a;
    border-radius: 3px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #354560;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    border: none;
    height: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #252d3a;
    border-radius: 3px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #354560;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
    width: 0;
    border: none;
}

/* ── Progress Bar ──────────────────────────────────────────────────────────── */

QProgressBar {
    background: #090b0d;
    border: 1px solid #1e2530;
    border-radius: 3px;
    color: transparent;
    font-size: 10px;
    max-height: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #006e96, stop:1 #00c8f0);
    border-radius: 2px;
}

/* ── Status Bar ────────────────────────────────────────────────────────────── */

QStatusBar {
    background: #090b0d;
    border-top: 1px solid #1a2030;
    color: #5a6a7a;
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 11px;
    padding: 2px 10px;
}

QStatusBar::item {
    border: none;
}

/* ── Menu Bar ──────────────────────────────────────────────────────────────── */

QMenuBar {
    background: #090b0d;
    border-bottom: 1px solid #1a2030;
    color: #8a9aaa;
    font-size: 12px;
    padding: 1px 0;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 2px;
    margin: 1px 2px;
}

QMenuBar::item:selected {
    background: #161c24;
    color: #c8d2dc;
}

QMenuBar::item:pressed {
    background: #1a2535;
    color: #00c8f0;
}

/* ── Menu ──────────────────────────────────────────────────────────────────── */

QMenu {
    background: #13181f;
    border: 1px solid #252d3a;
    border-radius: 4px;
    color: #b8c2cc;
    padding: 4px 0;
}

QMenu::item {
    padding: 6px 18px 6px 24px;
    font-size: 12px;
}

QMenu::item:selected {
    background: #0d2a3f;
    color: #00c8f0;
}

QMenu::item:disabled {
    color: #363e4a;
}

QMenu::separator {
    background: #252d3a;
    height: 1px;
    margin: 4px 8px;
}

/* ── Tooltips ──────────────────────────────────────────────────────────────── */

QToolTip {
    background: #13181f;
    border: 1px solid #00c8f060;
    border-radius: 3px;
    color: #b8c2cc;
    font-size: 11px;
    padding: 4px 8px;
}

/* ── Playback Bar ──────────────────────────────────────────────────────────── */

#playback_bar {
    background: #090b0d;
    border-top: 1px solid #1a2030;
    padding: 5px 12px;
}

#playback_bar QPushButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #5a7a96;
    font-size: 16px;
    min-width: 34px;
    min-height: 34px;
    padding: 0;
}

#playback_bar QPushButton:hover {
    background: #161c24;
    border-color: #252d3a;
    color: #c8d2dc;
}

#playback_bar QPushButton:pressed {
    background: #0e1520;
    color: #00c8f0;
    border-color: #00c8f060;
}

#playback_bar QPushButton:checked {
    background: #091f14;
    border-color: #00c86040;
    color: #00c860;
}

/* ── Timeline Slider ───────────────────────────────────────────────────────── */

#timeline_slider::groove:horizontal {
    height: 4px;
    background: #161c24;
    border: 1px solid #252d3a;
    border-radius: 2px;
}

#timeline_slider::handle:horizontal {
    width: 13px;
    height: 13px;
    margin: -5px 0;
    border-radius: 7px;
    background: #c8d2dc;
    border: 1px solid #8a9aaa;
}

#timeline_slider::handle:horizontal:hover {
    background: #00c8f0;
    border-color: #00c8f0;
}

#timeline_slider::sub-page:horizontal {
    background: #004d6a;
    border-radius: 2px;
    border: none;
}

/* ── Timecode Label ────────────────────────────────────────────────────────── */

#timecode_label {
    background: transparent;
    color: #4a5a6a;
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 11px;
    letter-spacing: 1px;
    min-width: 90px;
}

/* ── Section-specific overrides ────────────────────────────────────────────── */

#section_input QGroupBox::title     { color: #5a9acc; }
#section_blob QGroupBox::title      { color: #cc8844; }
#section_tracking QGroupBox::title  { color: #7acc7a; }
#section_effects QGroupBox::title   { color: #cc7acc; }
#section_frame_fx QGroupBox::title  { color: #cccc5a; }
#section_creative QGroupBox::title  { color: #f06090; }
#section_output QGroupBox::title    { color: #5acccc; }
#section_presets QGroupBox::title   { color: #7a7acc; }
